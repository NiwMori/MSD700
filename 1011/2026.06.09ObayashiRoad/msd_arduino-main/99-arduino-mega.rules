# arduino Mega USB port
KERNEL=="ttyACM*", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0042", MODE="0666", SYMLINK+="arduino-mega-usb"
# UART USB converter
# Future Technology Devices International, Ltd FT232 Serial (UART) IC
KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE="0666", SYMLINK+="arduino-mega-uart"
