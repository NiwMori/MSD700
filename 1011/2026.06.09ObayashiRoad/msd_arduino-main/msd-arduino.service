[Unit]
Description=MSD Arduino ROS 2 bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=msd700
Group=msd700
WorkingDirectory=/home/msd700/msd_ws
Environment=HOME=/home/msd700
Environment=USER=msd700
Environment=LOGNAME=msd700
Environment=ROS_LOG_DIR=/home/msd700/.ros/log
EnvironmentFile=-/home/msd700/msd_ws/src/msd_arduino/msd-arduino.env
ExecStartPre=/bin/mkdir -p /home/msd700/.ros/log
ExecStart=/bin/bash -lc 'for i in {1..30}; do [ -e /dev/arduino-mega-uart ] && break; sleep 1; done; source /opt/ros/humble/setup.bash && source /home/msd700/msd_ws/install/setup.bash && exec ros2 launch msd_arduino msd_arduino.launch.py'
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
