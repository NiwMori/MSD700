{
    "server": {
        "address": "#livekit_addr#",
        "port": #livekit_port#,
        "api-key": "#livekit_api_key#",
        "secret-key": "#livekit_api_secret#",
        "room": "vp-birdseye",
    },
    "screen-res": [1420, 960],
    "bitrate": 2048,
    "cameras": [
